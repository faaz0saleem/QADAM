# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase — Settings -> API in the dashboard
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. NEVER prefix this with EXPO_PUBLIC_ and never import it from
# app code: it bypasses every RLS policy. It belongs in Edge Function secrets.
SUPABASE_SERVICE_ROLE_KEY=

# Where `npm test` builds its scratch database. Any Postgres 15+ you can create
# databases on. `supabase start` serves one on port 54322.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# AdMob — rewarded video only (§7.8). There is deliberately no interstitial or
# banner unit here; §13.5 forbids an ad anywhere in the shopping flow.
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
