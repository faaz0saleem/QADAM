# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
# Anything ending in _SECRET or _SERVICE_ROLE_ is server-side only. If one of them
# ends up in the Expo app bundle it is public — Expo inlines every EXPO_PUBLIC_ var
# into the shipped JavaScript.

# ── Supabase ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never prefix this with EXPO_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# ── Device attestation (§6.1) ───────────────────────────────────────────────
GOOGLE_PLAY_INTEGRITY_PROJECT_NUMBER=
APPLE_APP_ATTEST_TEAM_ID=
APPLE_APP_ATTEST_BUNDLE_ID=

# ── Ads (§7.8 — rewarded video only, never in the shopping flow) ────────────
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_IOS=

# ── Order confirmation (§7.5) ───────────────────────────────────────────────
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_BUSINESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Courier (Phase 2 — whichever account lands first) ───────────────────────
COURIER_PROVIDER=tcs
COURIER_API_BASE=
COURIER_API_KEY=
